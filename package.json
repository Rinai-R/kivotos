{
  "name": "kivotos",
  "version": "0.1.1",
  "private": true,
  "description": "Kivotos: a DeepSeek Harness plugin that federates dsh hosts over Tailscale, with a complete mobile layout",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mobile",
    "remote",
    "tailscale"
  ],
  "homepage": "https://github.com/Rinai-R/kivotos",
  "bugs": {
    "url": "https://github.com/Rinai-R/kivotos/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Rinai",
    "email": "1130157066@qq.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rinai-R/kivotos.git"
  },
  "workspaces": [
    "packages/kivotos",
    "packages/mobile"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:check:files": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "npm run typecheck -w packages/kivotos && npm run typecheck -w packages/mobile",
    "build": "npm run build -w packages/kivotos",
    "test": "npm test -w packages/kivotos",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "lefthook": "^2.1.6",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  }
}
