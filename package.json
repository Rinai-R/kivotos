{
  "name": "kivotos",
  "version": "0.1.0",
  "private": true,
  "description": "Kivotos: a DeepSeek Harness plugin that federates dsh hosts over Tailscale, with a complete mobile layout",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mobile",
    "remote",
    "tailscale"
  ],
  "homepage": "https://github.com/Rinai-R/kivotos",
  "bugs": {
    "url": "https://github.com/Rinai-R/kivotos/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Rinai",
    "email": "1130157066@qq.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rinai-R/kivotos.git"
  },
  "workspaces": [
    "packages/kivotos"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:check:files": "oxfmt --check",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node --check packages/kivotos/index.js && node --check packages/kivotos/client.js",
    "test": "node --test \"packages/kivotos/test/*.test.js\"",
    "prepare": "lefthook install --force"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  }
}
